# ── Copy this file to .env and fill in your own values ──────────────────────
# Never commit .env or real API keys to Git.

# AI provider credentials (keys stay on the Render backend)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# GEMINI_MODEL=gemini-2.5-flash

# Provider priority for automatic fallback
AI_PROVIDER_ORDER=groq,openrouter,gemini

# Stream generation budgets (milliseconds)
AI_STREAM_TOTAL_TIMEOUT_MS=55000
AI_STREAM_PROVIDER_TIMEOUT_MS=18000

# Public app URL used in OpenRouter request metadata
APP_URL=https://neuroaii.netlify.app

# Comma-separated frontend origins
ALLOWED_ORIGINS=https://neuroaii.netlify.app

# Render supplies PORT automatically
PORT=10000
