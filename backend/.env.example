# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit .env to Git!

# Your Gemini API key (get it from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed frontend origins (your Netlify URL)
# Example: https://neurox-ai.netlify.app
ALLOWED_ORIGINS=https://your-site.netlify.app

# Port (Render sets this automatically — do not change)
PORT=10000
